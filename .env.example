# ---------------------------------------------------------------------------
# HDSAT local development configuration
# Copy to .env and fill in the values for YOUR Supabase project.
# Only the publishable/anon key belongs here. NEVER put a service-role key,
# database password or PythonAnywhere API token in this file or in the client.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable ("anon") key. Row Level Security enforces access.
VITE_SUPABASE_ANON_KEY=

# Optional: origin used for Supabase auth email redirects during development.
VITE_SITE_URL=http://localhost:3000

# Flask backend (used by backend/app.py at runtime; not baked into the bundle)
HDSAT_ENV=development
HDSAT_SITE_NAME=HDSAT

# ---------------------------------------------------------------------------
# Legal, safety and appeals configuration (baked into the bundle at build time)
# Unset values fall back to neutral wording, so the policy pages always render.
# Set these to publish accurate policies on a live deployment.
# ---------------------------------------------------------------------------

# Operator name used throughout the Terms, e.g. "HDSAT Prep LLC".
VITE_OPERATOR_NAME=

# Support / designated-agent mailbox shown on the policy pages and footer.
# Leave blank until the mailbox exists; the in-app appeal form still works.
VITE_SUPPORT_EMAIL=

# Governing law jurisdiction, e.g. "the State of Delaware, United States".
# Leave blank to avoid asserting a jurisdiction you have not chosen.
VITE_JURISDICTION=

# Policy version reported by /api/legal (bump when policies change).
HDSAT_LEGAL_VERSION=1.0
