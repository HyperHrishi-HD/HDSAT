# ---------------------------------------------------------------------------
# HDSAT local development configuration
# Copy to .env and fill in the values for YOUR Supabase project.
# Only the publishable/anon key belongs here. NEVER put a service-role key,
# database password or PythonAnywhere API token in this file or in the client.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable ("anon") key. Row Level Security enforces access.
VITE_SUPABASE_ANON_KEY=

# Optional: origin used for Supabase auth email redirects during development.
VITE_SITE_URL=http://localhost:3000

# Flask backend (used by backend/app.py at runtime; not baked into the bundle)
HDSAT_ENV=development
HDSAT_SITE_NAME=HDSAT
